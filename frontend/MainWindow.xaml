<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WeatherApp.Converters"
        Title="YourWeather | 你的天气"
        Height="760"
        Width="1120"
        MinHeight="640"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{Binding WindowBackground}">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:IconNameToEmojiConverter x:Key="IconNameToEmojiConverter" />
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{Binding CardBackground}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="{Binding HeaderBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="☁" FontSize="34" Foreground="White" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="YourWeather" Foreground="White" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="你的天气" Foreground="#EAF6FF" FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="320" Height="40" FontSize="15" Padding="12,8" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入城市名，例如 北京、上海、London">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索" Width="78" Height="40" Margin="10,0,0,0" Command="{Binding SearchCommand}" />
                    <Button Content="刷新" Width="78" Height="40" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="℃ / ℉" Width="82" Height="36" Command="{Binding ToggleUnitsCommand}" />
                    <Button Content="主题" Width="70" Height="36" Margin="10,0,0,0" Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding CurrentWeather.LocationText}" FontSize="30" FontWeight="Bold" Foreground="{Binding PrimaryText}" />
                                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{Binding SecondaryText}" Margin="0,4,0,18" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayTemperature}" FontSize="92" FontWeight="Light" Foreground="{Binding AccentBrush}" />
                                    <StackPanel Margin="26,18,0,0">
                                        <TextBlock Text="{Binding CurrentWeather.Condition}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding PrimaryText}" />
                                        <TextBlock Text="{Binding DisplayFeelsLike}" FontSize="18" Foreground="{Binding SecondaryText}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding CurrentWeather.IconName, Converter={StaticResource IconNameToEmojiConverter}}" FontSize="132" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,20,12">
                                <TextBlock Text="湿度" Foreground="{Binding SecondaryText}" />
                                <TextBlock Text="{Binding CurrentWeather.Humidity, StringFormat={}{0}%}" FontSize="22" FontWeight="Bold" Foreground="{Binding PrimaryText}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,20,12">
                                <TextBlock Text="风速" Foreground="{Binding SecondaryText}" />
                                <TextBlock Text="{Binding DisplayWindSpeed}" FontSize="22" FontWeight="Bold" Foreground="{Binding PrimaryText}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,20,12">
                                <TextBlock Text="气压" Foreground="{Binding SecondaryText}" />
                                <TextBlock Text="{Binding CurrentWeather.Pressure, StringFormat={}{0:F0} hPa}" FontSize="22" FontWeight="Bold" Foreground="{Binding PrimaryText}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,20,12">
                                <TextBlock Text="降水" Foreground="{Binding SecondaryText}" />
                                <TextBlock Text="{Binding CurrentWeather.Precipitation, StringFormat={}{0:F1} mm}" FontSize="22" FontWeight="Bold" Foreground="{Binding PrimaryText}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,20,12">
                                <TextBlock Text="UV 指数" Foreground="{Binding SecondaryText}" />
                                <TextBlock Text="{Binding CurrentWeather.UvIndex}" FontSize="22" FontWeight="Bold" Foreground="{Binding PrimaryText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="24小时预报" FontSize="20" FontWeight="Bold" Foreground="{Binding PrimaryText}" Margin="0,0,0,14" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding HourlyForecasts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="92" Margin="0,0,10,0" Padding="10" CornerRadius="14" Background="{Binding DataContext.SubtleBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding IconName, Converter={StaticResource IconNameToEmojiConverter}}" FontSize="28" HorizontalAlignment="Center" Margin="0,8" />
                                                    <TextBlock Text="{Binding Temperature, StringFormat={}{0:F0}°}" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding PrecipitationProbability, StringFormat=降水 {0:F0}%}" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="7天预报" FontSize="20" FontWeight="Bold" Foreground="{Binding PrimaryText}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding DailyForecasts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Margin="0,0,0,8" CornerRadius="12" Background="{Binding DataContext.SubtleBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=MM/dd ddd}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding IconName, Converter={StaticResource IconNameToEmojiConverter}}" FontSize="24" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Condition}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding TempRange}" FontWeight="Bold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="最近访问" FontSize="20" FontWeight="Bold" Foreground="{Binding PrimaryText}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding RecentCities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Margin="0,0,8,8" Padding="12,6" Command="{Binding DataContext.LoadRecentCityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Text="数据来源：Open-Meteo API。自动每 10 分钟刷新。" HorizontalAlignment="Right" Foreground="{Binding SecondaryText}" />

        <Border Grid.RowSpan="3" Background="#99000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="8" />
                <TextBlock Text="正在获取天气数据..." Foreground="White" FontSize="16" Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
